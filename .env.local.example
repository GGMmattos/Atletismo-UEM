# IDs dos formulários criados em https://formspree.io (ex: xreqwabc)
# Copie este arquivo para .env.local e preencha os valores reais.
# No deploy (Vercel/Netlify), configure as mesmas variáveis no painel do projeto.
NEXT_PUBLIC_FORMSPREE_ID=

# Formulário de agendamento do "Escola na Pista" — use um formulário Formspree
# separado do de Contato acima, para não misturar os dois assuntos na mesma caixa.
NEXT_PUBLIC_FORMSPREE_ESCOLA_ID=
